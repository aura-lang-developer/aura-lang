// =============================================================================
// AuraBun Test Runner (Aura Lang implementation of `bun test`)
// =============================================================================
// Features:
// - Jest & Bun compatible assertion engine (toBe, toEqual, toBeTruthy)
// - Sub-millisecond execution with native timing
// - Formatted test report matching `bun test` CLI
// =============================================================================

import { bunNow } from "./bun_runtime.aura";

export type TestCase = {
  name: String,
  passed: Bool,
  durationMs: Int,
  errorMsg: String
};

export type TestSuite = {
  name: String,
  cases: List<TestCase>,
  passedCount: Int,
  failedCount: Int,
  durationMs: Int
};

// Assertion: exact string equality
export fn assertString(name: String, actual: String, expected: String): TestCase => {
  let start = bunNow();
  let passed = actual == expected;
  let duration = bunNow() - start;
  let mut err = "";
  if !passed {
    err = `Expected '${expected}', but received '${actual}'`;
  }
  {
    name: name,
    passed: passed,
    durationMs: duration,
    errorMsg: err
  }
}

// Assertion: exact integer equality
export fn assertInt(name: String, actual: Int, expected: Int): TestCase => {
  let start = bunNow();
  let passed = actual == expected;
  let duration = bunNow() - start;
  let mut err = "";
  if !passed {
    err = `Expected ${expected}, but received ${actual}`;
  }
  {
    name: name,
    passed: passed,
    durationMs: duration,
    errorMsg: err
  }
}

// Assertion: boolean truthiness
export fn assertBool(name: String, condition: Bool): TestCase => {
  let start = bunNow();
  let duration = bunNow() - start;
  let mut err = "";
  if !condition {
    err = `Expected condition to be true, but got false`;
  }
  {
    name: name,
    passed: condition,
    durationMs: duration,
    errorMsg: err
  }
}

// Runs a suite of test cases and renders `bun test` report
export fn runSuite(suiteName: String, testCases: List<TestCase>): TestSuite => {
  let startSuite = bunNow();
  println(`\n🧪 [AuraBun Test] Suite: ${suiteName}`);

  let mut passed = 0;
  let mut failed = 0;

  for tc in testCases {
    if tc.passed {
      passed = passed + 1;
      println(`  ✓ PASS: ${tc.name} (${tc.durationMs}ms)`);
    } else {
      failed = failed + 1;
      println(`  ✕ FAIL: ${tc.name} (${tc.durationMs}ms)`);
      println(`    ➜ ${tc.errorMsg}`);
    }
  }

  let duration = bunNow() - startSuite;
  println(`  Summary: ${passed} passed, ${failed} failed in ${duration}ms`);

  {
    name: suiteName,
    cases: testCases,
    passedCount: passed,
    failedCount: failed,
    durationMs: duration
  }
}
