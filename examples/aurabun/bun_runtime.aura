// =============================================================================
// AuraBun Runtime Core (Aura Lang implementation of Bun Native APIs)
// =============================================================================
// Provides zero-overhead system abstractions matching Bun's standard library:
// - Bun.file(path) & Bun.write(path, data)
// - Bun.hash(data) (Fast cryptographic & content hashing)
// - Bun.env & Bun.which
// - Bun.serve (Fast HTTP server)
// =============================================================================

export type BunFileRef = {
  path: String,
  exists: Bool,
  size: Int,
  content: String
};

export type BunServerConfig = {
  port: Int,
  hostname: String,
  version: String
};

// Represents a Bun-compatible file handle
export fn bunFile(filePath: String): BunFileRef => {
  let content = os.readFile(filePath);
  let exists = content.length > 0;
  let size = content.length;
  {
    path: filePath,
    exists: exists,
    size: size,
    content: content
  }
}

// Writes file contents atomically to disk
export fn bunWrite(filePath: String, data: String): Result<Int, String> => {
  os.writeFile(filePath, data);
  Ok(data.length)
}

// Computes fast SHA-256 hash
export fn bunHash(data: String): String => {
  crypto.sha256(data)
}

// Access environment variables
export fn bunEnv(key: String, fallback: String = ""): String => {
  let val = os.env(key);
  if (val != "") {
    val
  } else {
    fallback
  }
}

// High resolution timing helper
export fn bunNow(): Int => {
  time.now()
}

// Formats byte sizes into human-readable strings (e.g. 1.25 MB)
export fn formatBytes(bytes: Int): String => {
  if (bytes < 1024) {
    `${bytes} B`
  } else if (bytes < 1048576) {
    let kb = bytes / 1024;
    `${kb} KB`
  } else {
    let mb = bytes / 1048576;
    `${mb} MB`
  }
}
