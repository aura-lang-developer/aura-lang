// Example 040: Count Vowels
// Inspects text characters to count standard vowels.

fn countVowels(s: String): Int => {
    let mut count = 0;
    let mut i = 0;
    while i < s.length {
        let ch = s[i];
        if ch == "a" || ch == "e" || ch == "i" || ch == "o" || ch == "u" ||
           ch == "A" || ch == "E" || ch == "I" || ch == "O" || ch == "U" {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

export fn main(): Unit => {
    let text = "Beautiful Architecture";
    println(`Vowels in '${text}': ${countVowels(text)}`);
}
