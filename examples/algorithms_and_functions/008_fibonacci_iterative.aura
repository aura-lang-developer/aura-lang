// Example 008: Fibonacci Iterative
// Computes the n-th Fibonacci number iteratively in O(n).

fn fibonacci(n: Int): Int => {
    if n <= 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }
    let mut a = 0;
    let mut b = 1;
    let mut i = 2;
    while i <= n {
        let temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    b
}

export fn main(): Unit => {
    println(`Fibonacci(8) = ${fibonacci(8)}`);
    println(`Fibonacci(10) = ${fibonacci(10)}`);
}
