// Example 030: Map Elements (Double Values)
// Transforms each element in a slice.

fn doubleElements(items: []Int): []Int => {
    let mut result: []Int = [];
    for x in items {
        result.push(x * 2);
    }
    result
}

export fn main(): Unit => {
    let input = [1, 2, 3, 4, 5];
    println(`Doubled: ${doubleElements(input)}`);
}
