// Example 018: Collatz Conjecture Steps
// Counts the number of steps required to reach 1.

fn collatzSteps(n: Int): Int => {
    let mut current = n;
    let mut steps = 0;
    while current > 1 {
        if current % 2 == 0 {
            current = current / 2;
        } else {
            current = 3 * current + 1;
        }
        steps = steps + 1;
    }
    steps
}

export fn main(): Unit => {
    println(`Collatz steps for 27: ${collatzSteps(27)}`);
    println(`Collatz steps for 12: ${collatzSteps(12)}`);
}
