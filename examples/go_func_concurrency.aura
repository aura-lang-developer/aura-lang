// =============================================================================
// 'go func()' Style Concurrency Example in Aura Language
// =============================================================================
// Aura supports the CSP (Communicating Sequential Processes) concurrency model
// inspired directly by Golang.
//
// In Go:
//   go func() { ... }()
//   go func(id int) { ... }(i)
//
// In Aura:
//   go (fn() => { ... })()
//   go (fn(id: Int) => { ... })(i)
//   go { ... }  // Direct ergonomic Aura syntax
// =============================================================================

export async fn main(): Task<Unit, String> => {
  println("==========================================================");
  println("  Aura CSP Concurrency: 'go func()' Format (Goroutines)   ");
  println("==========================================================");

  let jobsCh = Channel.make<String>(5);
  let resultsCh = Channel.make<String>(5);
  let wg = WaitGroup.new();

  // -------------------------------------------------------------------------
  // 1. Basic Anonymous Goroutine: exact 'go func() { ... }()' style
  // -------------------------------------------------------------------------
  wg.add(1);
  go(fn() => {
    println("[go func #1] Anonymous goroutine running in background.");
    jobsCh <- "Task Alpha";
    jobsCh <- "Task Beta";
    jobsCh <- "Task Gamma";
    Channel.close(jobsCh);
    wg.done();
  })();

  // -------------------------------------------------------------------------
  // 2. Anonymous Goroutine with Arguments: 'go func(id int) { ... }(i)' style
  //    (Passing parameters by value to avoid variable capture issues)
  // -------------------------------------------------------------------------
  let workersCount = 2;
  wg.add(workersCount);

  for workerId in[1, 2] {
    go(fn(id: Int) => {
      println(`[go func worker #${id}] Started and listening on channel...`);
      for job in jobsCh {
        println(`[go func worker #${id}] Processing: ${job}`);
        resultsCh <- `OK: [${job}] completed by worker #${id}`;
      };
      println(`[go func worker #${id}] Finished.`);
      wg.done();
    })(workerId);
  };

  // -------------------------------------------------------------------------
  // 3. Supervisor Goroutine with 'go { ... }' block
  //    Waits for all workers to finish and closes the results channel
  // -------------------------------------------------------------------------
  go {
    await wg.wait();
    Channel.close(resultsCh);
    println("[Supervisor] All workers finished. Channel closed.");
  };

  // -------------------------------------------------------------------------
  // 4. Result Consumption in Main Fiber
  // -------------------------------------------------------------------------
  for res in resultsCh {
    println(`[Received Result] -> ${res}`);
  };

  // -------------------------------------------------------------------------
  // 5. Non-blocking multiplexing with 'select' and 'timeout'
  // -------------------------------------------------------------------------
  let alertCh = Channel.make<String>(1);

  go(fn() => {
    alertCh <- "System notification received";
  })();

  select {
    case msg = <-alertCh => {
      match msg {
        Some(txt) => println(`[Select] ${txt}`),
        None => println("[Select] Alert channel closed"),
      }
    },
    case timeout(500) => {
      println("[Select] Timeout: No response within 500ms");
    },
    default => {
      println("[Select] No event available immediately");
    }
  };

  println("==========================================================");
  println("  Concurrency pipeline completed successfully             ");
  println("==========================================================");
};
