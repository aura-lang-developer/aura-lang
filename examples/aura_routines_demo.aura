// Concurrency with Aura Routines and CSP Channels (Go-Style)

export async fn worker(id: Int, jobsCh: RecvChannel<String>, resultsCh: SendChannel<String>, wg: WaitGroup): Task<Unit, String> => {
  routine {
    for job in jobsCh {
      println(`[Aura Routine #${id}] Processing: ${job}`);
      resultsCh <- `Result of ${job} (processed by routine #${id})`;
    };
    wg.done();
  };
};

export async fn main(): Task<Unit, String> => {
  println("--- Starting Concurrency with Aura Routines ---");

  let jobsCh = Channel.make<String>(10);
  let resultsCh = Channel.make<String>(10);
  let wg = WaitGroup.new();

  // Launch 3 consumer Aura Routines
  wg.add(3);
  await worker(1, jobsCh, resultsCh, wg);
  await worker(2, jobsCh, resultsCh, wg);
  await worker(3, jobsCh, resultsCh, wg);

  // Producer Aura Routine
  routine {
    jobsCh <- "Task A: Data analysis";
    jobsCh <- "Task B: Vector indexing";
    jobsCh <- "Task C: Matrix computation";
    jobsCh <- "Task D: Network synchronization";
    Channel.close(jobsCh);
  };

  // Supervisor Aura Routine to close results when workers finish
  routine {
    await wg.wait();
    Channel.close(resultsCh);
  };

  // Consume results in the main fiber
  for res in resultsCh {
    println(`[Consumer] Received: ${res}`);
  };

  println("--- Aura Routines completed successfully ---");
};
