// ==============================================================================
// Aura Lang — Golang Public and Private Methods Model Demonstration
// ==============================================================================
// In Aura, following Go's visibility model:
// 1. Public Methods (Exported): Start with UPPERCASE (PascalCase).
//    - Visible outside the module/package.
//    - Automatically exported in .d.ts definitions and binary symbols.
//    - In Go transpilation, they generate 'func (r Recv) Method()'.
// 2. Private Methods (Unexported): Start with LOWERCASE (camelCase).
//    - Package-scoped internal visibility.
//    - Not exported externally.
//    - In Go transpilation, they generate 'func (r Recv) method()'.
// ==============================================================================

// --- 1. Domain Struct Definition ---

export struct BankAccount {
  accountNumber: String,
  owner: String,
  balance: Float,
  pinHash: String,
  isFrozen: Bool
};

// --- 2. Public Methods with Receiver (PascalCase) ---

// Deposit funds into account
fn(b: * BankAccount)Deposit(amount: Float): Result<Float, String> => {
  if (!b.validatePositiveAmount(amount)) {
    return Err("Deposit amount must be greater than 0.");
  }
  if (b.isFrozen) {
    return Err("The account is temporarily frozen.");
  }

  b.balance = b.balance + amount;
  b.recordAudit(`Successful deposit of $${amount}`);
  Ok(b.balance)
}

// Withdraw funds verifying PIN through private method
fn(b: * BankAccount)Withdraw(amount: Float, pin: String): Result<Float, String> => {
  // Call internal private method
  if (!b.verifyPin(pin)) {
    b.recordAudit("Failed withdrawal attempt: invalid PIN");
    return Err("Invalid security PIN.");
  }
  if (!b.validatePositiveAmount(amount)) {
    return Err("Withdrawal amount must be positive.");
  }
  if (amount>b.balance) {
    return Err(`Insufficient funds. Current balance: $${b.balance}`);
  }

  b.balance = b.balance - amount;
  b.recordAudit(`Successful withdrawal of $${amount}`);
  Ok(b.balance)
}

// Query current balance
fn(b: BankAccount)GetBalance(): Float => b.balance;

// Account status summary
fn(b: BankAccount)Summary(): String => {
  `[Account: ${b.accountNumber}] Owner: ${b.owner} | Balance: $${b.balance} | Status: ${b.statusLabel()}`
}

// --- 3. Private / Internal Methods (camelCase) ---
// These methods are internal package helpers for business logic.

fn(b: BankAccount)verifyPin(inputPin: String): Bool => {
  // Internal credential hash validation
  b.pinHash == inputPin
}

fn(b: BankAccount)validatePositiveAmount(amount: Float): Bool => {
  amount>0.0
}

fn(b: BankAccount)statusLabel(): String => {
  if (b.isFrozen) {
    "FROZEN"
  }else {
    "ACTIVE"
  }
}

fn(b: BankAccount)recordAudit(message: String): Unit => {
  println(`  🔒 [AUDIT-LOG] [Account: ${b.accountNumber}] ${message}`);
}

// --- 4. Public Structural Interface (Go-Style Duck Typing) ---

export interface AccountSummary {
  GetBalance(): Float;
  Summary(): String;
}

fn printAccountStatement(acc: AccountSummary): Unit => {
  println("--- Official Bank Statement ---");
  println(acc.Summary());
  println(`Verified balance: $${acc.GetBalance()}`);
}

// --- 5. Public & Private Standalone Functions & First-Class Functions ---

// Public standalone function (PascalCase): exported and globally accessible
export fn CalculateFee(amount: Float, feePercent: Float): Float => {
  roundTwoDecimals(amount * (feePercent / 100.0))
}

// Private standalone function (camelCase): internal package helper
fn roundTwoDecimals(val: Float): Float => {
  // Two decimal rounding simulation
  val
}

// Higher-order function: accepts a function as argument
export fn ApplyTransactionFee(balance: Float, amount: Float, feePolicy: (Float, Float) -> Float): Float => {
  let fee = feePolicy(amount, 1.5);
  balance - amount - fee
}

// First-class function factory: returns a closure
export fn MakeInterestCalculator(annualRate: Float): (Float) -> Float => {
  let monthlyRate = annualRate / 12.0 / 100.0;
  fn(principal: Float): Float => principal * monthlyRate
}

// --- 6. Main Entry Point ---

export fn main(): Unit => {
  println("==================================================================");
  println("  🏛️  AURA LANG: GOLANG PUBLIC AND PRIVATE METHODS MODEL");
  println("  ✨  INCLUDING STANDALONE & FIRST-CLASS FUNCTIONS (PASCALCASE)");
  println("==================================================================");

  let mut account: BankAccount = {
    accountNumber: "CL-849201",
    owner: "Ada Lovelace",
    balance: 1500.0,
    pinHash: "4321",
    isFrozen: false
  };

  let p = & account;

  // Public Methods Invocation
  println("1. Querying initial status with public method Summary():");
  println(p.Summary());
  println("");

  println("2. Making $500.0 deposit with public method Deposit():");
  let depRes = p.Deposit(500.0);
  match depRes {
    Ok(newBal) => println(`✓ Deposit credited. New balance: $${newBal}`),
    Err(e) => println(`✕ Error: ${e}`)
  }
  println("");

  println("3. Attempting withdrawal with wrong PIN (testing private method verifyPin):");
  let badWithdraw = p.Withdraw(200.0, "0000");
  match badWithdraw {
    Ok(_) => println("✕ Error: should not permit withdrawal"),
    Err(e) => println(`✓ Expected validation caught: "${e}"`)
  }
  println("");

  println("4. Making legitimate withdrawal of $300.0 with correct PIN '4321':");
  let goodWithdraw = p.Withdraw(300.0, "4321");
  match goodWithdraw {
    Ok(newBal) => println(`✓ Withdrawal completed successfully. New balance: $${newBal}`),
    Err(e) => println(`✕ Unexpected error: ${e}`)
  }
  println("");

  println("5. Verifying structural interface satisfaction with Duck Typing:");
  printAccountStatement(account);
  println("");

  println("6. Standalone Functions in PascalCase:");
  let directFee = CalculateFee(1000.0, 2.5);
  println(`✓ Fee calculated with public standalone function CalculateFee: $${directFee}`);

  println("7. First-Class Functions:");
  // Pass standalone function as argument
  let postFeeBal = ApplyTransactionFee(account.GetBalance(), 100.0, CalculateFee);
  println(`✓ Balance after fee via higher-order ApplyTransactionFee: $${postFeeBal}`);

  // Assign function to capitalized variable and call it
  let FeeStrategy = CalculateFee;
  let customFee = FeeStrategy(200.0, 3.0);
  println(`✓ Invocation of function stored in variable FeeStrategy: $${customFee}`);

  // Return function from function (Closure)
  let calcMonthlyInterest = MakeInterestCalculator(6.0);
  let interest = calcMonthlyInterest(account.GetBalance());
  println(`✓ Monthly interest generated by closure: $${interest}`);

  println("==================================================================");
  println("  ✨ Model validated successfully in Aura and native backends.");
  println("==================================================================");
}
