// Go-Style Concurrency: Goroutines with 'go' and 'go (fn() => ... )()'

export async fn worker(id: Int, jobsCh: RecvChannel<String>, resultsCh: SendChannel<String>, wg: WaitGroup): Task<Unit, String> => {
  go {
    for job in jobsCh {
      println(`[Goroutine #${id}] Processing: ${job}`);
      resultsCh <- `OK [${job}] processed by goroutine #${id}`;
    };
    wg.done();
  };
};

export async fn main(): Task<Unit, String> => {
  println("--- Starting Concurrency with Goroutines ('go') in Aura ---");

  let jobsCh = Channel.make<String>(10);
  let resultsCh = Channel.make<String>(10);
  let wg = WaitGroup.new();

  // 1. Launch function goroutines (style: 'go worker(...)')
  wg.add(2);
  await worker(1, jobsCh, resultsCh, wg);
  await worker(2, jobsCh, resultsCh, wg);

  // 2. Producer goroutine with direct block: 'go { ... }'
  go {
    jobsCh <- "Auth Microservice";
    jobsCh <- "Billing Microservice";
    jobsCh <- "Inventory Microservice";
    Channel.close(jobsCh);
  };

  // 3. Supervisor goroutine with anonymous function: 'go (fn() => { ... })()' (exact 'go func()' style)
  go(fn() => async {
    await wg.wait();
    Channel.close(resultsCh);
  })();

  // 4. Consume results
  for res in resultsCh {
    println(`[Main Consumer] Received: ${res}`);
  };

  println("--- All Goroutines finished successfully ---");
};
