// ==============================================================================
// Aura Backend: Slice Concept Demonstration (Golang Model)
// ==============================================================================
// In Aura, sequential collections directly adhere to Go's slice model:
// 1. Go type syntax: `[]T` (equivalent to `List<T>` / `Array<T>`)
// 2. Slicing expressions: `s[low:high]`, `s[:high]`, `s[low:]`, `s[:]`, `s[low:high:max]`
// 3. Built-in functions: `len(s)`, `cap(s)`, `append(s, item)`
// 4. Methods and properties: `s.len`, `s.cap`, `s.length`, `s.capacity`, `s.push(item)`
// 5. String slicing: `"string"[start:end]`
// ==============================================================================

fn calculateSum(items: []Int): Int => {
  let mut accumulator: Int = 0;
  for x in items {
    accumulator = accumulator + x;
  }
  return accumulator;
}

export fn main(): Unit => {
  println("=== 1. Slice Creation and Indexing ===");
  let mut numbers: []Int = [10, 20, 30, 40, 50, 60, 70];
  println(`Original slice: length = ${len(numbers)}, capacity = ${cap(numbers)}`);

  println("\n=== 2. Slicing Expressions (Golang Syntax) ===");
  // Sub-slice with [start:end] range
  let sub = numbers[1: 4];
  println(`numbers[1:4]: len=${len(sub)}, elements=[${sub[0]}, ${sub[1]}, ${sub[2]}]`);

  // From start to index [:end]
  let firstElements = numbers[: 3];
  println(`numbers[:3]: len=${len(firstElements)}, elements=[${firstElements[0]}, ${firstElements[1]}, ${firstElements[2]}]`);

  // From index to the end [start:]
  let lastElements = numbers[4: ];
  println(`numbers[4:]: len=${len(lastElements)}, elements=[${lastElements[0]}, ${lastElements[1]}, ${lastElements[2]}]`);

  // Full copy [:]
  let copy = numbers[: ];
  println(`numbers[:]: len=${len(copy)}`);

  // 3-index slice [start:end:max_capacity]
  let bounded = numbers[1: 3: 5];
  println(`numbers[1:3:5]: len=${len(bounded)}`);

  println("\n=== 3. Dynamic Growth: append and push ===");
  // Go-style invocation: append
  let extended = append(numbers, 80);
  println(`append(numbers, 80) -> new length: ${len(extended)}`);

  // In-place modification (TS/Go style)
  numbers.push(90);
  println(`numbers.push(90) -> current length: ${numbers.length}`);

  println("\n=== 4. String Slices ===");
  let message = "Aura Backend Engine";
  let prefix = message[0: 4];
  let rest = message[5: ];
  println(`message[0:4] = "${prefix}"`);
  println(`message[5:] = "${rest}"`);

  println("\n=== 5. Functions with []T Parameters and Pipelines ===");
  let sumSub = calculateSum(numbers[2: 6]);
  println(`calculateSum(numbers[2:6]) = ${sumSub}`);

  // Integration with functional pipelines
  let transformed = numbers[1: 5]
  |> filter(fn(x: Int): Bool => x % 20 == 0)
  |> map(fn(x: Int): Int => x * 2);

  println(`numbers[1:5] filtered and transformed: len=${len(transformed)}, first=${transformed[0]}`);

  println("\n✨ Demonstration completed successfully!");
}
