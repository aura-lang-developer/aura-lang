// Counters for automatic IDs
let mut nextAuthorId: Int = 10;
let mut nextEditorialId: Int = 10;
let mut nextBookId: Int = 10;
let mut nextArticleId: Int = 10;
let mut nextSaleId: Int = 1002;

// --- Search and Validation Helper Functions ---

fn findAuthor(id: String): Any => {
  let matched = authors.filter(fn(a: Any): Bool => a.id == id);
  if (matched.length>0) {
    matched[0]
  }else {
    ()
  }
}

fn findEditorial(id: String): Any => {
  let matched = editorials.filter(fn(e: Any): Bool => e.id == id);
  if (matched.length>0) {
    matched[0]
  }else {
    ()
  }
}

fn findBook(id: String): Any => {
  let matched = books.filter(fn(b: Any): Bool => b.id == id);
  if (matched.length>0) {
    matched[0]
  }else {
    ()
  }
}

fn findArticle(id: String): Any => {
  let matched = articles.filter(fn(a: Any): Bool => a.id == id);
  if (matched.length>0) {
    matched[0]
  }else {
    ()
  }
}

fn findSale(id: String): Any => {
  let matched = sales.filter(fn(s: Any): Bool => s.id == id);
  if (matched.length>0) {
    matched[0]
  }else {
    ()
  }
}

fn getBooksByAuthor(authorId: String): List<Any> => {
  books.filter(fn(b: Any): Bool => b.authorId == authorId)
}

fn getArticlesByAuthor(authorId: String): List<Any> => {
  articles.filter(fn(a: Any): Bool => a.authorId == authorId)
}

fn getBooksByEditorial(editorialId: String): List<Any> => {
  books.filter(fn(b: Any): Bool => b.editorialId == editorialId)
}

fn enrichBook(b: Any): Any => {
  let author = findAuthor(b.authorId);
  let editorial = findEditorial(b.editorialId);
  let authorName = if (author != ()) {author.name}else {"Unknown Author"};
  let editorialName = if (editorial != ()) {editorial.name}else {"Unknown Publisher"};

  {
    id: b.id,
    title: b.title,
    isbn: b.isbn,
    authorId: b.authorId,
    authorName: authorName,
    editorialId: b.editorialId,
    editorialName: editorialName,
    price: b.price,
    stock: b.stock,
    genre: b.genre,
    publishedYear: b.publishedYear
  }
}

// --- Mux Creation and Middlewares ---

let mux = http.newServeMux();

// 1. Middleware de Logging & Headers CORS
mux.use(fn(req: Any, res: Any, next: Any) => {
  println(`[HTTP] ${req.method} ${req.url}`);
  res.setHeader("Access-Control-Allow-Origin", "*");
  res.setHeader("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type, Authorization");
  res.setHeader("X-Powered-By", "Aura-Lang REST Engine");

  if (req.method == "OPTIONS") {
    res.writeHead(http.StatusNoContent);
    res.end();
    return();
  }

  next();
});

