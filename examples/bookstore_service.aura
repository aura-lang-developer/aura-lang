// ==============================================================================
// 6. ENDPOINTS DE VENTA DE LIBROS (/api/books/:id/sell & /api/sales)
// ==============================================================================

// Centralized function to execute book sale
fn executeBookSale(bookId: String, body: Any, res: Any) => {
  let book = findBook(bookId);

  if (book == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Cannot complete sale: book with ID '${bookId}' does not exist`
    });
    return();
  }

  let quantity = if (body.quantity != ()) {body.quantity}else {1};
  if (quantity <= 0) {
    http.json(res, http.StatusBadRequest, {
      success: false,
      error: "La cantidad a comprar debe ser un entero positivo mayor a 0"
    });
    return();
  }

  if (book.stock<quantity) {
    http.json(res, http.StatusBadRequest, {
      success: false,
      error: `Stock insuficiente para '${book.title}'. Stock disponible: ${book.stock}, cantidad solicitada: ${quantity}`
    });
    return();
  }

  let customerName = if (body.customerName != ()) {body.customerName}else {"Cliente Ocasional"};
  let customerEmail = if (body.customerEmail != ()) {body.customerEmail}else {"cliente@ventas.lat"};
  let paymentMethod = if (body.paymentMethod != ()) {body.paymentMethod}else {"CASH"};
  let discountPercent = if (body.discountPercent != ()) {body.discountPercent}else {0.0};

  // Financial calculation of the sale
  let unitPrice = book.price;
  let subtotal = unitPrice * quantity;
  let discountAmount = subtotal * (discountPercent / 100.0);
  let taxableAmount = subtotal - discountAmount;
  let taxPercent = 19.0;// 19% standard VAT
  let taxAmount = taxableAmount * (taxPercent / 100.0);
  let total = taxableAmount + taxAmount;

  // Deduct inventory atomically
  book.stock = book.stock - quantity;

  let author = findAuthor(book.authorId);
  let authorName = if (author != ()) {author.name}else {"Unknown Author"};

  nextSaleId = nextSaleId + 1;
  let saleId = `sale-${nextSaleId}`;

  let receipt = {
    id: saleId,
    bookId: book.id,
    bookTitle: book.title,
    authorName: authorName,
    quantity: quantity,
    unitPrice: unitPrice,
    subtotal: subtotal,
    discountPercent: discountPercent,
    discountAmount: discountAmount,
    taxPercent: taxPercent,
    taxAmount: taxAmount,
    total: total,
    customerName: customerName,
    customerEmail: customerEmail,
    paymentMethod: paymentMethod,
    timestamp: "2026-09-04T23:20:00Z",
    status: "COMPLETED"
  };

  sales.push(receipt);

  println(`[SALE] Book '${book.title}' x${quantity} sold to '${customerName}' ($${total}). Stock restante: ${book.stock}`);

  http.json(res, http.StatusCreated, {
    success: true,
    message: `Venta #${saleId} procesada exitosamente`,
    receipt: receipt,
    inventory: {
      bookId: book.id,
      bookTitle: book.title,
      remainingStock: book.stock
    }
  });
}

// Specific endpoint: Sell a book by its URL ID
mux.post("/api/books/:id/sell", fn(req: Any, res: Any) => async {
  let bookId = http.pathValue(req, "id");
  let parseRes = await http.parseJson(req);
  match parseRes {
    Ok(body) => {
      executeBookSale(bookId, body, res);
    },
    Err(_) => {
      // Permitir venta sin body (compra por defecto de 1 unidad al contado)
      executeBookSale(bookId, {}, res);
    }
  }
});

// General endpoint: Create sale specifying bookId in request body
mux.post("/api/sales", fn(req: Any, res: Any) => async {
  let parseRes = await http.parseJson(req);
  match parseRes {
    Ok(body) => {
      if (body.bookId == () || body.bookId == "") {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El campo 'bookId' es obligatorio en el cuerpo de la solicitud"
        });
        return();
      }
      executeBookSale(body.bookId, body, res);
    },
    Err(err) => {
      http.json(res, http.StatusBadRequest, {
        success: false,
        error: `Invalid JSON payload: ${err}`
      });
    }
  }
});

// List all sales transactions
mux.get("/api/sales", fn(req: Any, res: Any) => {
  let bookFilter = http.query(req, "bookId");
  let customerFilter = http.query(req, "customerEmail");

  let filtered = sales.filter(fn(s: Any): Bool => {
    let matchBook = bookFilter == "" || s.bookId == bookFilter;
    let matchCustomer = customerFilter == "" || s.customerEmail == customerFilter;
    matchBook && matchCustomer
  });

  http.json(res, http.StatusOK, {
    success: true,
    count: filtered.length,
    data: filtered
  });
});

// Summary / Sales Metrics Dashboard
mux.get("/api/sales/summary", fn(req: Any, res: Any) => {
  let mut totalSold = 0;
  let mut totalRevenue = 0.0;
  let mut totalTax = 0.0;
  let mut totalDiscounts = 0.0;

  for s in sales {
    totalSold = totalSold + s.quantity;
    totalRevenue = totalRevenue + s.total;
    totalTax = totalTax + s.taxAmount;
    totalDiscounts = totalDiscounts + s.discountAmount;
  }

  let averageTicket = if (sales.length>0) {
    totalRevenue / sales.length
  }else {
    0.0
  };

  http.json(res, http.StatusOK, {
    success: true,
    summary: {
      totalTransactions: sales.length,
      totalBooksSoldUnits: totalSold,
      totalGrossRevenue: totalRevenue,
      totalTaxCollected: totalTax,
      totalDiscountsGiven: totalDiscounts,
      averageTicketValue: averageTicket,
      currency: "USD"
    }
  });
});

// Get sales receipt by ID
mux.get("/api/sales/:id", fn(req: Any, res: Any) => {
  let saleId = http.pathValue(req, "id");
  let sale = findSale(saleId);

  if (sale == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Sales receipt with id '${saleId}' not found`
    });
    return();
  }

  http.json(res, http.StatusOK, {
    success: true,
    data: sale
  });
});

