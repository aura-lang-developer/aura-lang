// ==============================================================================
// 2. AUTHORS MANAGEMENT (/api/authors)
// ==============================================================================

mux.get("/api/authors", fn(req: Any, res: Any) => {
  let nationalityFilter = http.query(req, "nationality");
  let search = http.query(req, "search");

  let filtered = authors.filter(fn(a: Any): Bool => {
    let matchNationality = nationalityFilter == "" || a.nationality.toLowerCase() == nationalityFilter.toLowerCase();
    let matchSearch = search == "" || a.name.toLowerCase().includes(search.toLowerCase());
    matchNationality && matchSearch
  });

  http.json(res, http.StatusOK, {
    success: true,
    count: filtered.length,
    data: filtered
  });
});

mux.get("/api/authors/:id", fn(req: Any, res: Any) => {
  let authorId = http.pathValue(req, "id");
  let author = findAuthor(authorId);

  if (author == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Author with id '${authorId}' not found`
    });
    return();
  }

  let authorBooks = getBooksByAuthor(authorId);
  let authorArticles = getArticlesByAuthor(authorId);

  http.json(res, http.StatusOK, {
    success: true,
    data: {
      author: author,
      bibliography: {
        booksCount: authorBooks.length,
        books: authorBooks,
        articlesCount: authorArticles.length,
        articles: authorArticles
      }
    }
  });
});

mux.post("/api/authors", fn(req: Any, res: Any) => async {
  let parseRes = await http.parseJson(req);
  match parseRes {
    Ok(body) => {
      if (body.name == () || body.name == "") {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El campo 'name' es obligatorio"
        });
        return();
      }
      if (body.email == () || body.email == "") {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El campo 'email' es obligatorio"
        });
        return();
      }

      nextAuthorId = nextAuthorId + 1;
      let newId = `aut-${nextAuthorId}`;
      let newAuthor = {
        id: newId,
        name: body.name,
        email: body.email,
        nationality: if (body.nationality != ()) {body.nationality}else {"Desconocida"},
        biography: if (body.biography != ()) {body.biography}else {""},
        birthYear: if (body.birthYear != ()) {body.birthYear}else {0}
      };

      authors.push(newAuthor);

      http.json(res, http.StatusCreated, {
        success: true,
        message: "Author registered successfully",
        data: newAuthor
      });
    },
    Err(err) => {
      http.json(res, http.StatusBadRequest, {
        success: false,
        error: `Invalid JSON payload: ${err}`
      });
    }
  }
});

mux.put("/api/authors/:id", fn(req: Any, res: Any) => async {
  let authorId = http.pathValue(req, "id");
  let author = findAuthor(authorId);

  if (author == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Author with id '${authorId}' not found`
    });
    return();
  }

  let parseRes = await http.parseJson(req);
  match parseRes {
    Ok(body) => {
      if (body.name != ()) {author.name = body.name; }
      if (body.email != ()) {author.email = body.email; }
      if (body.nationality != ()) {author.nationality = body.nationality; }
      if (body.biography != ()) {author.biography = body.biography; }
      if (body.birthYear != ()) {author.birthYear = body.birthYear; }

      http.json(res, http.StatusOK, {
        success: true,
        message: "Author updated successfully",
        data: author
      });
    },
    Err(err) => {
      http.json(res, http.StatusBadRequest, {
        success: false,
        error: `Invalid JSON payload: ${err}`
      });
    }
  }
});

mux.delete("/api/authors/:id", fn(req: Any, res: Any) => {
  let authorId = http.pathValue(req, "id");
  let author = findAuthor(authorId);

  if (author == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Author with id '${authorId}' not found`
    });
    return();
  }

  // Integrity validation: do not delete author with registered books or articles
  let authorBooks = getBooksByAuthor(authorId);
  if (authorBooks.length>0) {
    http.json(res, http.StatusBadRequest, {
      success: false,
      error: `Cannot delete author: has ${authorBooks.length} book(s) associated in the catalog.`
    });
    return();
  }

  let mut newAuthors: List<Any> = [];
  for a in authors {
    if (a.id != authorId) {
      newAuthors.push(a);
    }
  }
  authors = newAuthors;

  http.json(res, http.StatusOK, {
    success: true,
    message: `Author '${author.name}' (ID: ${authorId}) deleted successfully.`
  });
});

// ==============================================================================
// 3. PUBLISHERS MANAGEMENT (/api/editorials)
// ==============================================================================

mux.get("/api/editorials", fn(req: Any, res: Any) => {
  let countryFilter = http.query(req, "country");
  let search = http.query(req, "search");

  let filtered = editorials.filter(fn(e: Any): Bool => {
    let matchCountry = countryFilter == "" || e.country.toLowerCase() == countryFilter.toLowerCase();
    let matchSearch = search == "" || e.name.toLowerCase().includes(search.toLowerCase());
    matchCountry && matchSearch
  });

  http.json(res, http.StatusOK, {
    success: true,
    count: filtered.length,
    data: filtered
  });
});

mux.get("/api/editorials/:id", fn(req: Any, res: Any) => {
  let editorialId = http.pathValue(req, "id");
  let editorial = findEditorial(editorialId);

  if (editorial == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Publisher with id '${editorialId}' not found`
    });
    return();
  }

  let publishedBooks = getBooksByEditorial(editorialId);

  http.json(res, http.StatusOK, {
    success: true,
    data: {
      editorial: editorial,
      catalog: {
        totalBooks: publishedBooks.length,
        books: publishedBooks
      }
    }
  });
});

mux.post("/api/editorials", fn(req: Any, res: Any) => async {
  let parseRes = await http.parseJson(req);
  match parseRes {
    Ok(body) => {
      if (body.name == () || body.name == "") {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El campo 'name' es obligatorio"
        });
        return();
      }
      if (body.country == () || body.country == "") {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El campo 'country' es obligatorio"
        });
        return();
      }

      nextEditorialId = nextEditorialId + 1;
      let newId = `edt-${nextEditorialId}`;
      let newEditorial = {
        id: newId,
        name: body.name,
        country: body.country,
        foundedYear: if (body.foundedYear != ()) {body.foundedYear}else {0},
        website: if (body.website != ()) {body.website}else {""}
      };

      editorials.push(newEditorial);

      http.json(res, http.StatusCreated, {
        success: true,
        message: "Publisher registered successfully",
        data: newEditorial
      });
    },
    Err(err) => {
      http.json(res, http.StatusBadRequest, {
        success: false,
        error: `Invalid JSON payload: ${err}`
      });
    }
  }
});

mux.put("/api/editorials/:id", fn(req: Any, res: Any) => async {
  let editorialId = http.pathValue(req, "id");
  let editorial = findEditorial(editorialId);

  if (editorial == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Publisher with id '${editorialId}' not found`
    });
    return();
  }

  let parseRes = await http.parseJson(req);
  match parseRes {
    Ok(body) => {
      if (body.name != ()) {editorial.name = body.name; }
      if (body.country != ()) {editorial.country = body.country; }
      if (body.foundedYear != ()) {editorial.foundedYear = body.foundedYear; }
      if (body.website != ()) {editorial.website = body.website; }

      http.json(res, http.StatusOK, {
        success: true,
        message: "Publisher updated successfully",
        data: editorial
      });
    },
    Err(err) => {
      http.json(res, http.StatusBadRequest, {
        success: false,
        error: `Invalid JSON payload: ${err}`
      });
    }
  }
});

mux.delete("/api/editorials/:id", fn(req: Any, res: Any) => {
  let editorialId = http.pathValue(req, "id");
  let editorial = findEditorial(editorialId);

  if (editorial == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Publisher with id '${editorialId}' not found`
    });
    return();
  }

  // Integrity validation: do not delete publisher with assigned books
  let publishedBooks = getBooksByEditorial(editorialId);
  if (publishedBooks.length>0) {
    http.json(res, http.StatusBadRequest, {
      success: false,
      error: `Cannot delete publisher: has ${publishedBooks.length} book(s) associated in the catalog.`
    });
    return();
  }

  let mut newEditorials: List<Any> = [];
  for e in editorials {
    if (e.id != editorialId) {
      newEditorials.push(e);
    }
  }
  editorials = newEditorials;

  http.json(res, http.StatusOK, {
    success: true,
    message: `Publisher '${editorial.name}' (ID: ${editorialId}) deleted successfully.`
  });
});

// ==============================================================================
// 4. BOOKS MANAGEMENT (/api/books)
// ==============================================================================

mux.get("/api/books", fn(req: Any, res: Any) => {
  let genreFilter = http.query(req, "genre");
  let authorFilter = http.query(req, "authorId");
  let editorialFilter = http.query(req, "editorialId");
  let search = http.query(req, "search");
  let inStockFilter = http.query(req, "inStock");

  let filtered = books
  .filter(fn(b: Any): Bool => {
    let matchGenre = genreFilter == "" || b.genre.toLowerCase() == genreFilter.toLowerCase();
    let matchAuthor = authorFilter == "" || b.authorId == authorFilter;
    let matchEditorial = editorialFilter == "" || b.editorialId == editorialFilter;
    let matchStock = inStockFilter != "true" || b.stock>0;
    let matchSearch = if (search != "") {
      let term = search.toLowerCase();
      b.title.toLowerCase().includes(term) || b.isbn.toLowerCase().includes(term)
    }else {
      true
    };
    matchGenre && matchAuthor && matchEditorial && matchStock && matchSearch
  })
  .map(fn(b: Any): Any => enrichBook(b));

  http.json(res, http.StatusOK, {
    success: true,
    count: filtered.length,
    data: filtered
  });
});

mux.get("/api/books/:id", fn(req: Any, res: Any) => {
  let bookId = http.pathValue(req, "id");
  let book = findBook(bookId);

  if (book == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Book with id '${bookId}' not found`
    });
    return();
  }

  let author = findAuthor(book.authorId);
  let editorial = findEditorial(book.editorialId);

  http.json(res, http.StatusOK, {
    success: true,
    data: {
      id: book.id,
      title: book.title,
      isbn: book.isbn,
      price: book.price,
      stock: book.stock,
      genre: book.genre,
      publishedYear: book.publishedYear,
      author: author,
      editorial: editorial
    }
  });
});

mux.post("/api/books", fn(req: Any, res: Any) => async {
  let parseRes = await http.parseJson(req);
  match parseRes {
    Ok(body) => {
      // Validaciones requeridas
      if (body.title == () || body.title == "") {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El campo 'title' es obligatorio"
        });
        return();
      }
      if (body.isbn == () || body.isbn == "") {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El campo 'isbn' es obligatorio"
        });
        return();
      }
      if (body.authorId == () || body.authorId == "") {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El campo 'authorId' es obligatorio"
        });
        return();
      }
      if (body.editorialId == () || body.editorialId == "") {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El campo 'editorialId' es obligatorio"
        });
        return();
      }

      // Verificar que autor exista
      let author = findAuthor(body.authorId);
      if (author == ()) {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: `El autor con id '${body.authorId}' does not exist en el sistema`
        });
        return();
      }

      // Verificar que editorial exista
      let editorial = findEditorial(body.editorialId);
      if (editorial == ()) {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: `La editorial con id '${body.editorialId}' does not exist en el sistema`
        });
        return();
      }

      let price = if (body.price != ()) {body.price}else {0.0};
      if (price<0.0) {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El precio del libro no puede ser negativo"
        });
        return();
      }

      let stock = if (body.stock != ()) {body.stock}else {0};
      if (stock<0) {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El stock no puede ser negativo"
        });
        return();
      }

      nextBookId = nextBookId + 1;
      let newId = `bk-${nextBookId}`;
      let newBook = {
        id: newId,
        title: body.title,
        isbn: body.isbn,
        authorId: body.authorId,
        editorialId: body.editorialId,
        price: price,
        stock: stock,
        genre: if (body.genre != ()) {body.genre}else {"General"},
        publishedYear: if (body.publishedYear != ()) {body.publishedYear}else {2026}
      };

      books.push(newBook);

      http.json(res, http.StatusCreated, {
        success: true,
        message: "Book registered successfully",
        data: enrichBook(newBook)
      });
    },
    Err(err) => {
      http.json(res, http.StatusBadRequest, {
        success: false,
        error: `Invalid JSON payload: ${err}`
      });
    }
  }
});

mux.put("/api/books/:id", fn(req: Any, res: Any) => async {
  let bookId = http.pathValue(req, "id");
  let book = findBook(bookId);

  if (book == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Book with id '${bookId}' not found`
    });
    return();
  }

  let parseRes = await http.parseJson(req);
  match parseRes {
    Ok(body) => {
      if (body.title != ()) {book.title = body.title; }
      if (body.isbn != ()) {book.isbn = body.isbn; }
      if (body.price != ()) {
        if (body.price<0.0) {
          http.json(res, http.StatusBadRequest, {success: false, error: "El precio no puede ser negativo"});
          return();
        }
        book.price = body.price;
      }
      if (body.stock != ()) {
        if (body.stock<0) {
          http.json(res, http.StatusBadRequest, {success: false, error: "El stock no puede ser negativo"});
          return();
        }
        book.stock = body.stock;
      }
      if (body.genre != ()) {book.genre = body.genre; }
      if (body.publishedYear != ()) {book.publishedYear = body.publishedYear; }
      if (body.authorId != ()) {
        let author = findAuthor(body.authorId);
        if (author == ()) {
          http.json(res, http.StatusBadRequest, {success: false, error: `Author '${body.authorId}' does not exist`});
          return();
        }
        book.authorId = body.authorId;
      }
      if (body.editorialId != ()) {
        let editorial = findEditorial(body.editorialId);
        if (editorial == ()) {
          http.json(res, http.StatusBadRequest, {success: false, error: `Publisher '${body.editorialId}' does not exist`});
          return();
        }
        book.editorialId = body.editorialId;
      }

      http.json(res, http.StatusOK, {
        success: true,
        message: "Book updated successfully",
        data: enrichBook(book)
      });
    },
    Err(err) => {
      http.json(res, http.StatusBadRequest, {
        success: false,
        error: `Invalid JSON payload: ${err}`
      });
    }
  }
});

mux.delete("/api/books/:id", fn(req: Any, res: Any) => {
  let bookId = http.pathValue(req, "id");
  let book = findBook(bookId);

  if (book == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Book with id '${bookId}' not found`
    });
    return();
  }

  let mut newBooks: List<Any> = [];
  for b in books {
    if (b.id != bookId) {
      newBooks.push(b);
    }
  }
  books = newBooks;

  http.json(res, http.StatusOK, {
    success: true,
    message: `Book '${book.title}' (ID: ${bookId}) deleted successfully from catalog.`
  });
});

// ==============================================================================
// 5. ARTICLES MANAGEMENT (/api/articles)
// ==============================================================================

mux.get("/api/articles", fn(req: Any, res: Any) => {
  let topicFilter = http.query(req, "topic");
  let authorFilter = http.query(req, "authorId");
  let search = http.query(req, "search");

  let filtered = articles
  .filter(fn(a: Any): Bool => {
    let matchTopic = topicFilter == "" || a.topic.toLowerCase() == topicFilter.toLowerCase();
    let matchAuthor = authorFilter == "" || a.authorId == authorFilter;
    let matchSearch = if (search != "") {
      let term = search.toLowerCase();
      a.title.toLowerCase().includes(term) || a.summary.toLowerCase().includes(term)
    }else {
      true
    };
    matchTopic && matchAuthor && matchSearch
  })
  .map(fn(a: Any): Any => {
    let author = findAuthor(a.authorId);
    let authorName = if (author != ()) {author.name}else {"Desconocido"};
    {
      id: a.id,
      title: a.title,
      summary: a.summary,
      content: a.content,
      authorId: a.authorId,
      authorName: authorName,
      topic: a.topic,
      publishedAt: a.publishedAt
    }
  });

  http.json(res, http.StatusOK, {
    success: true,
    count: filtered.length,
    data: filtered
  });
});

mux.get("/api/articles/:id", fn(req: Any, res: Any) => {
  let articleId = http.pathValue(req, "id");
