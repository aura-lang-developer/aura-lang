// ==============================================================================
// 2. GESTIÓN DE AUTORES (/api/authors)
// ==============================================================================

mux.get("/api/authors", fn(req: Any, res: Any) => {
  let nationalityFilter = http.query(req, "nationality");
  let search = http.query(req, "search");

  let filtered = authors.filter(fn(a: Any): Bool => {
    let matchNationality = nationalityFilter == "" || a.nationality.toLowerCase() == nationalityFilter.toLowerCase();
    let matchSearch = search == "" || a.name.toLowerCase().includes(search.toLowerCase());
    matchNationality && matchSearch
  });

  http.json(res, http.StatusOK, {
    success: true,
    count: filtered.length,
    data: filtered
  });
});

mux.get("/api/authors/:id", fn(req: Any, res: Any) => {
  let authorId = http.pathValue(req, "id");
  let author = findAuthor(authorId);

  if (author == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Autor con id '${authorId}' no encontrado`
    });
    return();
  }

  let authorBooks = getBooksByAuthor(authorId);
  let authorArticles = getArticlesByAuthor(authorId);

  http.json(res, http.StatusOK, {
    success: true,
    data: {
      author: author,
      bibliography: {
        booksCount: authorBooks.length,
        books: authorBooks,
        articlesCount: authorArticles.length,
        articles: authorArticles
      }
    }
  });
});

mux.post("/api/authors", fn(req: Any, res: Any) => async {
  let parseRes = await http.parseJson(req);
  match parseRes {
    Ok(body) => {
      if (body.name == () || body.name == "") {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El campo 'name' es obligatorio"
        });
        return();
      }
      if (body.email == () || body.email == "") {
        http.json(res, http.StatusBadRequest, {
          success: false,
          error: "El campo 'email' es obligatorio"
        });
        return();
      }

      nextAuthorId = nextAuthorId + 1;
      let newId = `aut-${nextAuthorId}`;
      let newAuthor = {
        id: newId,
        name: body.name,
        email: body.email,
        nationality: if (body.nationality != ()) {body.nationality}else {"Desconocida"},
        biography: if (body.biography != ()) {body.biography}else {""},
        birthYear: if (body.birthYear != ()) {body.birthYear}else {0}
      };

      authors.push(newAuthor);

      http.json(res, http.StatusCreated, {
        success: true,
        message: "Autor registrado exitosamente",
        data: newAuthor
      });
    },
    Err(err) => {
      http.json(res, http.StatusBadRequest, {
        success: false,
        error: `Payload JSON inválido: ${err}`
      });
    }
  }
});

mux.put("/api/authors/:id", fn(req: Any, res: Any) => async {
  let authorId = http.pathValue(req, "id");
  let author = findAuthor(authorId);

  if (author == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Autor con id '${authorId}' no encontrado`
    });
    return();
  }

  let parseRes = await http.parseJson(req);
  match parseRes {
    Ok(body) => {
      if (body.name != ()) {author.name = body.name; }
      if (body.email != ()) {author.email = body.email; }
      if (body.nationality != ()) {author.nationality = body.nationality; }
      if (body.biography != ()) {author.biography = body.biography; }
      if (body.birthYear != ()) {author.birthYear = body.birthYear; }

      http.json(res, http.StatusOK, {
        success: true,
        message: "Autor actualizado con éxito",
        data: author
      });
    },
    Err(err) => {
      http.json(res, http.StatusBadRequest, {
        success: false,
        error: `Payload JSON inválido: ${err}`
      });
    }
  }
});

mux.delete("/api/authors/:id", fn(req: Any, res: Any) => {
  let authorId = http.pathValue(req, "id");
  let author = findAuthor(authorId);

  if (author == ()) {
    http.json(res, http.StatusNotFound, {
      success: false,
      error: `Autor con id '${authorId}' no encontrado`
    });
    return();
  }

  // Validación de integridad: no borrar autor con libros o artículos registrados
  let authorBooks = getBooksByAuthor(authorId);
  if (authorBooks.length>0) {
    http.json(res, http.StatusBadRequest, {
      success: false,
      error: `No se puede eliminar el autor: tiene ${authorBooks.length} libro(s) asociado(s) en el catálogo.`
    });
    return();
  }

  let mut newAuthors: List<Any> = [];
  for a in authors {
    if (a.id != authorId) {
      newAuthors.push(a);
    }
  }
  authors = newAuthors;

  http.json(res, http.StatusOK, {
    success: true,
    message: `Autor '${author.name}' (ID: ${authorId}) eliminado correctamente.`
  });
});

