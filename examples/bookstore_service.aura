// --- Tipos del Dominio ---

export type Author = {
  id: String,
  name: String,
  email: String,
  nationality: String,
  biography: String,
  birthYear: Int
}

export type Editorial = {
  id: String,
  name: String,
  country: String,
  foundedYear: Int,
  website: String
}

export type Book = {
  id: String,
  title: String,
  isbn: String,
  authorId: String,
  editorialId: String,
  price: Float,
  stock: Int,
  genre: String,
  publishedYear: Int
}

export type Article = {
  id: String,
  title: String,
  summary: String,
  content: String,
  authorId: String,
  topic: String,
  publishedAt: String
}

export type SaleRecord = {
  id: String,
  bookId: String,
  bookTitle: String,
  authorName: String,
  quantity: Int,
  unitPrice: Float,
  subtotal: Float,
  discountPercent: Float,
  discountAmount: Float,
  taxPercent: Float,
  taxAmount: Float,
  total: Float,
  customerName: String,
  customerEmail: String,
  paymentMethod: String,
  timestamp: String,
  status: String
}

