// Aura Standard Library: database/mysql
// Native MySQL Protocol 10 wire protocol database driver.

import { DB, Rows, Tx, ExecResult } from "../sql/sql";

/// Connects to a MySQL database using a DSN or connection URI.
export fn open(dsn: String = "mysql://root@127.0.0.1:3306/mysql", maxConns: Int = 10): DB => {
    sql.open("mysql", dsn, maxConns)
}

/// Alias for open()
export fn connect(dsn: String = "mysql://root@127.0.0.1:3306/mysql", maxConns: Int = 10): DB => {
    sql.open("mysql", dsn, maxConns)
}
