module Aura.Compiler.Main

import { tokenize } from "./lexer"
import { parseModule } from "./parser"
import { typecheckModule } from "./typechecker"
import { generate } from "./codegen"
import { generateGo } from "./codegen_go"
import { formatDiagnostic, error } from "./diagnostics"
import { Diagnostic, DiagError } from "./ast"

// -----------------------------------------------------------------------------
// DESIGN PATTERN: PIPELINE PATTERN (AURA SELF-HOSTED COMPILER)
// -----------------------------------------------------------------------------

/// Compiler pipeline configuration options.
export type CompilerOptions = {
  target: String,     // "js" | "go"
  checkOnly: Bool,    // Fast static analysis without codegen
  filename: String
}

/// Compiler pipeline context representing a compilation task with input source code and options.
export type CompilerPipeline = {
  source: String,
  options: CompilerOptions
}

/// Factory constructor creating a new CompilerPipeline for the specified source code and target.
export fn newPipeline(source: String, target: String, checkOnly: Bool, filename: String): CompilerPipeline {
  return {
    source: source,
    options: {
      target: target,
      checkOnly: checkOnly,
      filename: filename
    }
  };
}

/// Executes all stages of the enhanced self-hosted compilation pipeline:
/// 1. Tokenization (`tokenize`)
/// 2. Parsing (`parseModule`)
/// 3. Semantic Typechecking (`typecheckModule`)
/// 4. Multi-Target Code Generation (`generate` for JS or `generateGo` for Go)
/// - `pipeline`: The active compiler pipeline instance.
/// - Returns: `Ok(String)` containing generated target code, or `Err(String)` formatted diagnostic.
export fn executePipeline(pipeline: CompilerPipeline): Result<String, String> {
  // 1. Lexical Analysis
  let tokens = tokenize(pipeline.source)?;

  // 2. Syntax Analysis (Pratt Parser)
  let moduleNode = parseModule(tokens)?;

  // 3. Static Semantic Analysis & Typechecking
  let tc = typecheckModule(moduleNode);
  match tc {
    Ok(env) => {
      // 4. Multi-Target Code Generation
      if (pipeline.options.checkOnly) {
        return Ok("✓ Typecheck clean. Zero errors found.");
      }
      if (pipeline.options.target == "go") {
        return Ok(generateGo(moduleNode));
      }
      return Ok(generate(moduleNode));
    },
    Err(err) => {
      return Err(err);
    }
  }
}

/// Compiles Aura source code with default JS target and typechecking.
export fn compileAura(source: String): Result<String, String> {
  let pipeline = newPipeline(source, "js", false, "input.aura");
  return executePipeline(pipeline);
}

/// Compiles Aura source code to Go target.
export fn compileAuraToGo(source: String, filename: String): Result<String, String> {
  let pipeline = newPipeline(source, "go", false, filename);
  return executePipeline(pipeline);
}

/// CLI runner entrypoint that parses command-line arguments, validates input files,
/// runs the self-hosted compiler, and writes output files to disk.
export fn runCli(): () {
  let args = process.argv;
  let mut i = 2;
  while (i < args.length) {
    let arg = args[i];
    if (arg == "--version" || arg == "-V" || arg == "-v" || arg == "version") {
      println("aurac 0.7.1");
      return ();
    }
    i = i + 1;
  }

  if (args.length < 3) {
    println("Aura Self-Hosted Compiler (v0.7.1)");
    println("Usage: node aurac.mjs <file.aura> [-o <output>] [--target <js|go>] [--check] [--version]");
    return ();
  }

  let filename = args[2];
  let mut outputFilename = "output.js";
  let mut target = "js";
  let mut checkOnly = false;

  i = 3;
  while (i < args.length) {
    let arg = args[i];
    if (arg == "-o" && i + 1 < args.length) {
      outputFilename = args[i + 1];
      i = i + 1;
    } else if (arg == "--target" && i + 1 < args.length) {
      target = args[i + 1];
      i = i + 1;
    } else if (arg == "-t" && i + 1 < args.length) {
      target = args[i + 1];
      i = i + 1;
    } else if (arg == "--check") {
      checkOnly = true;
    }
    i = i + 1;
  }

  if (target == "go" && outputFilename == "output.js") {
    outputFilename = filename.replace(".aura", ".go");
  } else if (filename.endsWith(".aura") && outputFilename == "output.js") {
    outputFilename = filename.replace(".aura", ".js");
  }

  if (!fs.existsSync(filename)) {
    println(`Error: File '${filename}' not found.`);
    process.exit(1);
    return ();
  }

  let source = fs.readFileSync(filename, "utf8");
  let pipeline = newPipeline(source, target, checkOnly, filename);
  let result = executePipeline(pipeline);

  match result {
    Ok(code) => {
      if (checkOnly) {
        println(`✓ Checked '${filename}': 0 errors`);
      } else {
        fs.writeFileSync(outputFilename, code);
        println(`✓ Successfully compiled '${filename}' -> '${outputFilename}' (target: ${target})`);
      }
    },
    Err(err) => {
      println(`✕ Compilation error in '${filename}':\n${err}`);
      process.exit(1);
    }
  }
}

runCli();
