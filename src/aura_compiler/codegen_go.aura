module Aura.Compiler.CodeGenGo

import {
  ModuleNode, ItemNode, ParamNode, TypeNode, ExprNode, StmtNode, VariantNode,
  MatchArmNode, PatternNode,
  TyNamed, TyFunction, TyRecord, TyTuple, TyUnit,
  LitInt, LitFloat, LitString, LitBool, LitUnit,
  OpAdd, OpSub, OpMul, OpDiv, OpMod, OpEq, OpNeq, OpLt, OpLte, OpGt, OpGte, OpAnd, OpOr,
  OpNeg, OpNot,
  PatWildcard, PatVariable, PatLiteral, PatConstructor, PatList, PatRecord,
  ExprLit, ExprIdent, ExprBinary, ExprUnary, ExprPipe, ExprCall, ExprMember,
  ExprIndex, ExprIf, ExprWhile, ExprForIn, ExprMatch, ExprBlock, ExprList,
  ExprRecord, ExprTry, ExprReturn, ExprBreak, ExprContinue,
  StmtLet, StmtExpr, StmtReturn, StmtAssign,
  ItemFunction, ItemSumType, ItemTypeAlias, ItemImport, ItemStmt
} from "./ast"

// -----------------------------------------------------------------------------
// TYPE MAPPING: AURA -> GO
// -----------------------------------------------------------------------------

/// Converts an Aura AST TypeNode into an equivalent Go type signature.
export fn typeToGo(node: Option<TypeNode>): String {
  match node {
    None => "",
    Some(n) => match n {
      TyNamed { name, args } => {
        if (name == "Int") { return "int64"; }
        if (name == "Float") { return "float64"; }
        if (name == "String") { return "string"; }
        if (name == "Bool") { return "bool"; }
        if (name == "Unit" || name == "()") { return ""; }
        if (name == "Option" && args.length > 0) {
          return `*${typeToGo(Some(args[0]))}`;
        }
        if (name == "List" && args.length > 0) {
          return `[]${typeToGo(Some(args[0]))}`;
        }
        if (name == "Channel" && args.length > 0) {
          return `chan ${typeToGo(Some(args[0]))}`;
        }
        return name;
      },
      TyFunction { params: _, returnType: _ } => "func()",
      TyRecord { fields: _ } => "map[string]interface{}",
      TyTuple { items: _ } => "[]interface{}",
      TyUnit => ""
    }
  }
}

// -----------------------------------------------------------------------------
// EXPRESSION CODEGEN: AURA -> GO
// -----------------------------------------------------------------------------

/// Translates an Aura AST expression node into its equivalent Go source string.
export fn exprToGo(expr: ExprNode): String {
  match expr {
    ExprLit { lit } => {
      match lit {
        LitInt { val } => `${val}`,
        LitFloat { val } => `${val}`,
        LitString { val } => if (val.includes("${")) {
          // Go formatting
          `fmt.Sprintf("${val}")`
        } else {
          JSON.stringify(val)
        },
        LitBool { val } => if (val) { "true" } else { "false" },
        LitUnit => "struct{}{}"
      }
    },
    ExprIdent { name } => {
      if (name == "println") { return "fmt.Println"; }
      if (name == "print") { return "fmt.Print"; }
      name
    },
    ExprBinary { op, left, right } => {
      let l = exprToGo(left);
      let r = exprToGo(right);
      let opStr = match op {
        OpAdd => "+",
        OpSub => "-",
        OpMul => "*",
        OpDiv => "/",
        OpMod => "%",
        OpEq => "==",
        OpNeq => "!=",
        OpLt => "<",
        OpLte => "<=",
        OpGt => ">",
        OpGte => ">=",
        OpAnd => "&&",
        OpOr => "||"
      };
      `(${l} ${opStr} ${r})`
    },
    ExprUnary { op, expr: inner } => {
      let e = exprToGo(inner);
      match op {
        OpNeg => `(-${e})`,
        OpNot => `(!${e})`
      }
    },
    ExprPipe { left, right } => {
      let l = exprToGo(left);
      let r = exprToGo(right);
      `${r}(${l})`
    },
    ExprCall { callee, args } => {
      let c = exprToGo(callee);
      let mut argsStr = "";
      let mut i = 0;
      while (i < args.length) {
        if (i > 0) { argsStr = argsStr + ", "; }
        argsStr = argsStr + exprToGo(args[i]);
        i = i + 1;
      }
      `${c}(${argsStr})`
    },
    ExprMember { obj, field } => {
      let o = exprToGo(obj);
      if (field == "length") {
        return `int64(len(${o}))`;
      }
      `${o}.${field}`
    },
    ExprIndex { obj, index } => {
      let o = exprToGo(obj);
      let idx = exprToGo(index);
      `${o}[${idx}]`
    },
    ExprIf { cond, thenBranch, elseBranch } => {
      let c = exprToGo(cond);
      let t = exprToGo(thenBranch);
      match elseBranch {
        Some(e) => {
          let eb = exprToGo(e);
          `func() interface{} { if ${c} { return ${t} } else { return ${eb} } }()`
        },
        None => `if ${c} { ${t} }`
      }
    },
    ExprWhile { cond, body } => {
      let c = exprToGo(cond);
      let b = exprToGo(body);
      `for ${c} {\n    ${b}\n  }`
    },
    ExprForIn { indexName: _, varName, iter, body } => {
      let it = exprToGo(iter);
      let b = exprToGo(body);
      `for _, ${varName} := range ${it} {\n    ${b}\n  }`
    },
    ExprMatch { subject, arms } => {
      let s = exprToGo(subject);
      let mut out = `switch ${s} {\n`;
      let mut i = 0;
      while (i < arms.length) {
        let arm = arms[i];
        let patStr = match arm.pattern {
          PatWildcard => "default:",
          PatVariable { name } => `default:\n    ${name} := ${s}`,
          PatLiteral { lit } => `case ${exprToGo(ExprLit { lit: lit })}:`,
          PatConstructor { name, args: _ } => `case "${name}":`,
          _ => "default:"
        };
        let bodyStr = exprToGo(arm.body);
        out = out + `  ${patStr}\n    ${bodyStr}\n`;
        i = i + 1;
      }
      out = out + "  }";
      out
    },
    ExprBlock { stmts } => {
      let mut out = "";
      let mut i = 0;
      while (i < stmts.length) {
        out = out + stmtToGo(stmts[i]) + "\n  ";
        i = i + 1;
      }
      out
    },
    ExprList { items } => {
      let mut out = "[]interface{}{";
      let mut i = 0;
      while (i < items.length) {
        if (i > 0) { out = out + ", "; }
        out = out + exprToGo(items[i]);
        i = i + 1;
      }
      out + "}"
    },
    ExprRecord { fields } => {
      let mut out = "map[string]interface{}{\n";
      let mut i = 0;
      while (i < fields.length) {
        out = out + `    "${fields[i].key}": ${exprToGo(fields[i].value)},\n`;
        i = i + 1;
      }
      out + "  }"
    },
    ExprTry { inner } => {
      let inn = exprToGo(inner);
      `/* try */ ${inn}`
    },
    ExprReturn { val } => {
      match val {
        Some(v) => `return ${exprToGo(v)}`,
        None => "return"
      }
    },
    ExprBreak => "break",
    ExprContinue => "continue"
  }
}

// -----------------------------------------------------------------------------
// STATEMENT & ITEM CODEGEN: AURA -> GO
// -----------------------------------------------------------------------------

/// Translates a single AST statement into Go code.
export fn stmtToGo(stmt: StmtNode): String {
  match stmt {
    StmtLet { name, isMut: _, annot, val } => {
      let v = exprToGo(val);
      match annot {
        Some(ann) => {
          let tyStr = typeToGo(Some(ann));
          if (tyStr != "") {
            return `var ${name} ${tyStr} = ${v}`;
          }
          return `${name} := ${v}`;
        },
        None => `${name} := ${v}`
      }
    },
    StmtExpr { expr } => exprToGo(expr),
    StmtReturn { val } => match val {
      Some(v) => `return ${exprToGo(v)}`,
      None => "return"
    },
    StmtAssign { target, val } => `${target} = ${exprToGo(val)}`
  }
}

/// Translates a top-level module item into Go code.
export fn itemToGo(item: ItemNode): String {
  match item {
    ItemFunction { name, isExported, isAsync: _, params, returnType, body } => {
      // Go capitalization for exported functions
      let fnName = if (isExported && name != "main") {
        name.charAt(0).toUpperCase() + name.slice(1)
      } else {
        name
      };

      let mut paramsStr = "";
      let mut i = 0;
      while (i < params.length) {
        if (i > 0) { paramsStr = paramsStr + ", "; }
        let p = params[i];
        let tyStr = match p.annot {
          Some(ann) => {
            let t = typeToGo(Some(ann));
            if (t != "") { t } else { "interface{}" }
          },
          None => "interface{}"
        };
        paramsStr = paramsStr + `${p.name} ${tyStr}`;
        i = i + 1;
      }

      let retStr = match returnType {
        Some(ann) => {
          let t = typeToGo(Some(ann));
          if (t != "") { ` ${t}` } else { "" }
        },
        None => ""
      };

      let bodyStr = match body {
        ExprBlock { stmts: _ } => exprToGo(body),
        _ => if (retStr != "") { `return ${exprToGo(body)}` } else { exprToGo(body) }
      };
      `func ${fnName}(${paramsStr})${retStr} {\n  ${bodyStr}\n}`
    },
    ItemSumType { name, isExported: _, variants } => {
      let mut out = `type ${name} struct {\n  Tag string\n`;
      let mut i = 0;
      while (i < variants.length) {
        let v = variants[i];
        if (v.fields.length > 0) {
          out = out + `  ${v.name}Data interface{}\n`;
        }
        i = i + 1;
      }
      out + "}\n"
    },
    ItemTypeAlias { name, isExported: _, target } => {
      let t = typeToGo(Some(target));
      if (t != "") {
        `type ${name} = ${t}\n`
      } else {
        `type ${name} = interface{}\n`
      }
    },
    ItemImport { source: _, items: _ } => {
      "// import mapped automatically in Go\n"
    },
    ItemStmt { stmt: _ } => ""
  }
}

// -----------------------------------------------------------------------------
// ROOT MODULE CODE GENERATOR
// -----------------------------------------------------------------------------

/// Translates an entire Aura AST module into complete, compilable Go 1.21+ source code.
/// - `moduleNode`: Parsed AST module node.
/// - Returns: Complete Go source code string ready for `go build`.
export fn generateGo(moduleNode: ModuleNode): String {
  let mut out = "// Code generated by Aura Self-Hosted Compiler (v0.8.2 - Go Backend). DO NOT EDIT.\n";
  out = out + "package main\n\n";
  out = out + "import (\n";
  out = out + "  \"fmt\"\n";
  out = out + "  \"strings\"\n";
  out = out + "  \"sync\"\n";
  out = out + "  \"time\"\n";
  out = out + ")\n\n";

  let mut hasMain = false;
  let mut topStmts: List<StmtNode> = [];
  let mut otherItems: List<ItemNode> = [];

  let mut i: Int = 0;
  while (i < moduleNode.items.length) {
    let item = moduleNode.items[i];
    match item {
      ItemFunction { name, isExported: _, isAsync: _, params: _, returnType: _, body: _ } => {
        if (name == "main") {
          hasMain = true;
        }
        let _ = otherItems.push(item);
      },
      ItemStmt { stmt } => {
        let _ = topStmts.push(stmt);
      },
      _ => {
        let _ = otherItems.push(item);
      }
    };
    i = i + 1;
  }

  let mut j: Int = 0;
  while (j < otherItems.length) {
    let itemCode = itemToGo(otherItems[j]);
    if (itemCode != "") {
      out = out + itemCode + "\n\n";
    }
    j = j + 1;
  }

  if (topStmts.length > 0) {
    if (!hasMain) {
      out = out + "func main() {\n";
      let mut k: Int = 0;
      while (k < topStmts.length) {
        out = out + "  " + stmtToGo(topStmts[k]) + "\n";
        k = k + 1;
      }
      out = out + "}\n";
    } else {
      out = out + "func init() {\n";
      let mut k: Int = 0;
      while (k < topStmts.length) {
        out = out + "  " + stmtToGo(topStmts[k]) + "\n";
        k = k + 1;
      }
      out = out + "}\n";
    }
  } else if (!hasMain) {
    out = out + "func main() {}\n";
  }

  return out;
}
