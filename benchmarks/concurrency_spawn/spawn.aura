export async fn main(): Task<Unit, String> => {
    let count = 50000;
    let wg = WaitGroup.new();
    wg.add(count);

    let t0 = time.now();
    let mut i = 0;
    while i < count {
        spawn(async {
            wg.done();
        });
        i = i + 1;
    };

    await wg.wait();
    let dur = time.now() - t0;
    println(`[AURA] Spawned ${count} fibers in ${dur} ms`);
}
